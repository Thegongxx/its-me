# Explicit demo mode. Set false for production; never silently falls back to examples.
DEMO_MODE=true
# Canonical URL, use your preview URL for Preview and your domain for Production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never add NEXT_PUBLIC_ to this variable.
SUPABASE_SERVICE_ROLE_KEY=
